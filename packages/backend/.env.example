NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=2592000

# ─── AWS — use me-central-1 for Saudi PDPL data residency ───────────────────
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ─────────────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:8000    # local dev only — remove in prod
DYNAMODB_TABLE_PREFIX=handycall_dev_

# ─── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET_DOCUMENTS=handycall-documents-dev    # ID scans, profile photos, service photos
S3_BUCKET_RECEIPTS=handycall-receipts-dev      # booking receipts / ZATCA invoices

# ─── AWS SES ──────────────────────────────────────────────────────────────────
SES_REGION=me-central-1
SES_FROM_EMAIL=no-reply@yourdomain.com
SES_FROM_NAME=HandyCall

# Set to "console" to log emails instead of sending (local dev)
EMAIL_PROVIDER=console

# ─── Platform config (also stored in platform_config DynamoDB table) ──────────
PLATFORM_FEE_RATE=0.15
VAT_RATE=0.15

# ─── Payment gateway stub — integrate HyperPay or Moyasar for production ─────
# Both are SAMA-licensed Saudi payment gateways
PAYMENT_GATEWAY=hyperpay
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID_MADA=
HYPERPAY_ENTITY_ID_VISA=

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
