{
  "LambdaFunctionConfigurations": [
    {
      "Id": "PostCallProcessorTrigger",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:982081079378:function:handycall-post-call-processor",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "recordings/"
            },
            {
              "Name": "suffix",
              "Value": ".wav"
            }
          ]
        }
      }
    }
  ]
}
