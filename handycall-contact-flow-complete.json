{
  "Version": "2019-10-30",
  "StartAction": "SetInitialAttributes",
  "Metadata": {
    "entryPointPosition": {"x": 20, "y": 20},
    "snapToGrid": false
  },
  "Actions": [
    {
      "Identifier": "SetInitialAttributes",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": [
          {
            "Key": "UserInput",
            "Value": ""
          }
        ]
      },
      "Transitions": {
        "NextAction": "InvokeLambda",
        "Errors": [{"NextAction": "Disconnect", "ErrorType": "NoMatchingError"}],
        "Conditions": []
      }
    },
    {
      "Identifier": "InvokeLambda",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:us-east-1:982081079378:function:handycall-call-orchestrator",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": {
          "UserInput": "$.Attributes.UserInput"
        },
        "ResponseValidation": {
          "ResponseType": "STRING_MAP"
        }
      },
      "Transitions": {
        "NextAction": "CheckLambdaResponse",
        "Errors": [{"NextAction": "ErrorMessage", "ErrorType": "NoMatchingError"}],
        "Conditions": []
      }
    },
    {
      "Identifier": "CheckLambdaResponse",
      "Type": "Check",
      "Parameters": {
        "ComparisonValue": "$.External.response"
      },
      "Transitions": {
        "NextAction": "PlayAIResponse",
        "Errors": [{"NextAction": "ErrorMessage", "ErrorType": "NoMatchingError"}],
        "Conditions": [
          {
            "NextAction": "PlayAIResponse",
            "Condition": {
              "Operator": "IsPresent",
              "Operands": ["$.External.response"]
            }
          }
        ]
      }
    },
    {
      "Identifier": "PlayAIResponse",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "$.External.response"
      },
      "Transitions": {
        "NextAction": "GetCustomerInput",
        "Errors": [{"NextAction": "Disconnect", "ErrorType": "NoMatchingError"}],
        "Conditions": []
      }
    },
    {
      "Identifier": "GetCustomerInput",
      "Type": "GetParticipantInput",
      "Parameters": {
        "InputTimeLimitSeconds": "10",
        "Text": "I'm listening. You can continue speaking, or press star to end the call.",
        "DTMF": {
          "TerminatingDigits": ["#"],
          "MaxDigits": "1",
          "Timeout": "10"
        },
        "TextToSpeechVoice": "Matthew"
      },
      "Transitions": {
        "NextAction": "StoreUserInput",
        "Errors": [
          {"NextAction": "Disconnect", "ErrorType": "InputTimeLimitExceeded"},
          {"NextAction": "Disconnect", "ErrorType": "NoMatchingError"}
        ],
        "Conditions": []
      }
    },
    {
      "Identifier": "StoreUserInput",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": [
          {
            "Key": "UserInput",
            "Value": "$.StoredCustomerInput"
          }
        ]
      },
      "Transitions": {
        "NextAction": "CheckForDisconnect",
        "Errors": [{"NextAction": "InvokeLambda", "ErrorType": "NoMatchingError"}],
        "Conditions": []
      }
    },
    {
      "Identifier": "CheckForDisconnect",
      "Type": "Check",
      "Parameters": {
        "ComparisonValue": "$.Attributes.UserInput"
      },
      "Transitions": {
        "NextAction": "InvokeLambda",
        "Errors": [{"NextAction": "InvokeLambda", "ErrorType": "NoMatchingError"}],
        "Conditions": [
          {
            "NextAction": "Disconnect",
            "Condition": {
              "Operator": "Equals",
              "Operands": ["#"]
            }
          }
        ]
      }
    },
    {
      "Identifier": "ErrorMessage",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "I apologize, but I'm experiencing technical difficulties. Please try calling again later."
      },
      "Transitions": {
        "NextAction": "Disconnect",
        "Errors": [{"NextAction": "Disconnect", "ErrorType": "NoMatchingError"}],
        "Conditions": []
      }
    },
    {
      "Identifier": "Disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
